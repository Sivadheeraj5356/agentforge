# AgentForge environment variables
# Copy to apps/web/.env.local for local development. Never commit secrets.
# AGENTFORGE_* is canonical. VORTEX_* and existing HARBOR_* names are one-release aliases.

# ---------------------------------------------------------------------------
# apps/web (Next.js control plane)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Local Supabase (from `pnpm db:start` / `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:15421
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. Never expose via NEXT_PUBLIC_*. Not used for normal user queries.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ---------------------------------------------------------------------------
# Cloudflare R2 artifact storage (wired when set; otherwise local filesystem)
# ---------------------------------------------------------------------------

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=agentforge-artifacts
# R2_REGION=auto
# R2_PUBLIC_BASE_URL=

# Local untrusted ZIP ingest (outside apps/web). R2 replaces this when R2_* is set.
# AGENTFORGE_ARTIFACT_STORE_DIR=D:\ai-saas\vortex\.data\untrusted-ingest
# VORTEX_ARTIFACT_STORE_DIR=D:\ai-saas\vortex\.data\untrusted-ingest

# ---------------------------------------------------------------------------
# Stripe test mode (server-only). Does not gate local eval. Never NEXT_PUBLIC_STRIPE_SECRET.
# ---------------------------------------------------------------------------

# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
# STRIPE_PRICE_ID=price_

# ---------------------------------------------------------------------------
# Execution plane / evaluator (server-only; never NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# SUPABASE_URL=http://127.0.0.1:15421
# SUPABASE_SERVICE_ROLE_KEY=   # same demo key as above; server-only
# EVALUATOR_WORKER_ID=evaluator-1
# EVALUATOR_TIMEOUT_SECONDS=120
# EVALUATOR_LEASE_SECONDS=900
# ALLOW_FAKE=false
# SANDBOX_PROVIDER=isolated
# HARBOR_BIN=harbor
# AGENTFORGE_OPENAI_MODEL=gpt-4.1-mini
# HARBOR_MODEL=openai/gpt-4.1-mini
# AGENTFORGE_BYO_CMD=
# AGENTFORGE_BYO_HTTP_URL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# AGENTFORGE_WORK_MODEL_PROVIDER=openai
# AGENTFORGE_ENVIRONMENTS_DIR=D:\ai-saas\vortex\environments
# AGENTFORGE_EVAL_IMAGE=agentforge-eval-python:3.12
# AGENTFORGE_FIXTURES_DIR=D:\ai-saas\vortex\fixtures\eval
# AGENTFORGE_EVAL_ARTIFACT_DIR=D:\ai-saas\vortex\.data\eval-artifacts
# VORTEX_EVAL_IMAGE=agentforge-eval-python:3.12
# VORTEX_FIXTURES_DIR=D:\ai-saas\vortex\fixtures\eval
# VORTEX_EVAL_ARTIFACT_DIR=D:\ai-saas\vortex\.data\eval-artifacts
# Gitignored licensed dumps only — do not commit:
# TB_FIXTURES_DIR=D:\ai-saas\vortex\.data\benchmarks\terminal-bench-2
# AGENTFORGE_GIT_SHA=
# VORTEX_GIT_SHA=

# ---------------------------------------------------------------------------
# Conventions
# ---------------------------------------------------------------------------
# - NEXT_PUBLIC_* is browser-visible. Never put secrets there.
# - SUPABASE_SERVICE_ROLE_KEY is server-only. Never import into client components.
# - Normal user queries use the anon key + user session (RLS). Never service-role.
